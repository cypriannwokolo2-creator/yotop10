# ── YoTop10 Environment Template ──
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# For production, use Docker secrets (/run/secrets/) instead of env vars
# for all sensitive values.

# ── REQUIRED: JWT Secret (for admin authentication)
# Generate with: openssl rand -hex 32 (64 characters minimum)
JWT_SECRET=change-me-to-a-64-char-hex-secret

# ── Canonical site address (www is canonical; the apex 301-redirects to it —
# see nginx.conf). These values are BAKED INTO the frontend image at build
# time: changing them requires rebuilding + redeploying the frontend.
NEXT_PUBLIC_SITE_URL=https://www.yotop10.com
NEXT_PUBLIC_API_URL=https://www.yotop10.com/api
INTERNAL_API_URL=http://backend:8000/api

# ── CORS Allowed Origins
CORS_ORIGINS=https://yotop10.com,https://www.yotop10.com

# ── Database Credentials
MONGO_USERNAME=yotop10_admin
MONGO_ROOT_PASSWORD=change-me
MONGO_PASSWORD=change-me

REDIS_PASSWORD=change-me

ES_PASSWORD=change-me

# ── Nginx Domain (apex; www.<apex> is derived automatically and served as
# canonical. TLS certificate MUST cover both names,
# e.g. certbot -d yotop10.com -d www.yotop10.com)
NGINX_SERVER_NAME=yotop10.local

# ── Tunable Constants (optional — defaults shown)
# Rate limit window (default: 1 hour in ms)
RATE_LIMIT_WINDOW_MS=3600000
# Soft delete TTL before permanent removal (default: 30 days in ms)
SOFT_DELETE_TTL_MS=2592000000

# ── SEO / Social (optional)
# IndexNow API key for instant Bing/Yandex/Seznam/Naver indexing on publish.
# Generate with: openssl rand -hex 16 (16-64 hex chars). Host the key file at
# https://www.yotop10.com/<KEY>.txt (see docs/seo.md). Empty = disabled.
INDEXNOW_API_KEY=
# X/Twitter handle used in twitter:site / twitter:creator meta tags.
NEXT_PUBLIC_TWITTER_HANDLE=@yotop10
